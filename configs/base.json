    "recon_dim": 32,
    "recon_dropout": 0.05,
    "recon_proj_dim": 128,
    "rgb_proj_dim": 512,
    "recon_clamp": 8.0,
    "recon_fusion_scale_init": 0.05,
    "recon_bias_hidden_dim": 128,
    "recon_bias_recon_hidden_dim": 64,
    "recon_bias_scale_init": 0.05
