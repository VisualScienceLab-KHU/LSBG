    "test_repo_id": "nebula/OpenSDI_test",
    "test_splits": [
      "sd15",
      "sd2",
      "sdxl",
      "sd3",
      "flux"
    ],
    "train_prepared_dir": null,
    "test_prepared_dir": null
  },
  "reconstruction": {
    "root": null,
    "alias": "sd1_v1",
    "name": "vae_l1_rgbmean_zreal_128",
