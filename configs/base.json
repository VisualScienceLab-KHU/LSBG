{
  "paths": {
    "hf_home": "./cache/huggingface",
    "mae_checkpoint": "./weights/mae/mae_pretrain_vit_base.pth",
    "clip_cache_dir": "./weights/clip",
    "output_dir": "./outputs/regflow",
    "checkpoint": ""
