{
  "extends": "base.json",
  "mode": "train",
  "runtime": {
    "num_processes": 1,
    "device": "cuda"
  },
  "training": {
    "epochs": 10,
    "batch_size": 8,
    "accumulation_steps": 1,
    "augmentation": true,
    "data_scale": 1.0,
    "amp": false,
    "resume": "",
    "max_batches": 0,
    "save_checkpoints": true,
    "save_every": 0
  },
  "optimizer": {
    "lr": 5e-05,
    "min_lr": 0.0,
    "weight_decay": 0.05,
    "betas": [
      0.9,
      0.999
    ],
    "warmup_epochs": 0,
    "image_lr_scale": 1.0,
    "image_decay_after_epoch": 2,
    "image_decay_factor": 0.3
  },
  "validation": {
    "batch_size": 16,
    "max_batches": 0,
    "threshold": 0.5,
    "selection_split": "sd15",
    "model_overrides": {
      "pred_calib_k_max": 1.0
    }
  },
  "wandb": {
    "enabled": true,
    "mode": "online",
    "project": "ReGFLoW",
    "entity": null,
    "name": null,
    "group": null,
    "tags": []
  },
  "paths": {
    "output_dir": "./outputs/regflow"
  }
}
